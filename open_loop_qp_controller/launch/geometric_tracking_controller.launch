<launch>
  <arg name="config" default="$(find open_loop_qp_controller)/config/geometric_tracking.yaml"/>
  <arg name="plan_topic" default="/plan"/>
  <arg name="odom_topic" default="/odom1"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>

  <node pkg="open_loop_qp_controller" type="geometric_tracking_controller.py"
        name="geometric_tracking_controller" output="screen">
    <rosparam file="$(arg config)" command="load"/>
    <param name="plan_topic" value="$(arg plan_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
  </node>
</launch>
